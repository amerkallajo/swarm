{
  "name": "swarm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "prettier --check . && node --test tests/ci-validate.test.mjs && turbo run lint typecheck test build",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "pilot:audit": "pnpm --filter @swarm/pilot pilot:audit",
    "pilot:discover": "pnpm --filter @swarm/discovery pilot:discover",
    "pilot:draft": "pnpm --filter @swarm/pilot pilot:draft",
    "pilot:report": "pnpm --filter @swarm/pilot pilot:report",
    "pilot:score": "pnpm --filter @swarm/pilot pilot:score",
    "pilot:validate": "pnpm --filter @swarm/pilot pilot:validate",
    "test": "node --test tests/ci-validate.test.mjs && turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
