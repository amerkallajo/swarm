{
  "name": "@swarm/discovery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "pilot:discover": "tsc -p tsconfig.json && node dist/pilot-cli.js discover",
    "pilot:report": "tsc -p tsconfig.json && node dist/pilot-cli.js report",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.0.10"
  }
}
